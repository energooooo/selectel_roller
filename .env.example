# ======================================================================
#  ip-roller — МИНИМАЛЬНАЯ настройка
# ----------------------------------------------------------------------
#  В 99% случаев НИЧЕГО здесь руками заполнять НЕ нужно.
#  Просто запустите `./run.sh` (mac/linux) или `run.bat` (windows) —
#  программа сама спросит у вас логин/пароль/ID аккаунта и сохранит их
#  в реальный файл `.env` в этой папке.
#
#  Этот файл — только шаблон-справка, он попадает в git.
#  Настоящий `.env` программа создаст рядом и в git он не попадёт.
# ======================================================================

# --- Первый аккаунт Selectel (обязательно) ---
# Где взять:
#   SEL_USERNAME / SEL_PASSWORD — Панель Selectel → IAM → Сервисные
#                                 пользователи (создайте и сразу скопируйте пароль).
#   SEL_ACCOUNT_ID             — Правый верхний угол панели, под email'ом.
SEL_USERNAME=
SEL_PASSWORD=
SEL_ACCOUNT_ID=

# --- Первый аккаунт (опционально) ---
# Если НИЧЕГО из этого не задано, программа ВСЕГДА использует отдельный
# проект с именем `ip-roller`:
#   — если его ещё нет, создаст (не трогая ваши другие проекты);
#   — если уже есть, возьмёт именно его.
# Указывайте ниже только если хотите работать в другом, уже существующем проекте.
# SEL_PROJECT_NAME=
# SEL_PROJECT_ID=        # заполнится автоматически после первого запуска

# --- Второй аккаунт (опционально) ---
# Пустые SEL2_* = работаем только с первым аккаунтом.
# SEL2_USERNAME=
# SEL2_PASSWORD=
# SEL2_ACCOUNT_ID=
# SEL2_PROJECT_NAME=
# SEL2_PROJECT_ID=       # заполнится автоматически после первого запуска

# --- Третий, четвёртый и далее аккаунты (опционально) ---
# Аккаунтов можно задать СКОЛЬКО УГОДНО (до 64): просто увеличивайте номер в
# префиксе — SEL3_*, SEL4_*, SEL5_* … Дашборд покажет по колонке на каждый аккаунт.
# SEL3_USERNAME=
# SEL3_PASSWORD=
# SEL3_ACCOUNT_ID=
# SEL3_PROJECT_ID=       # заполнится автоматически после первого запуска
# (аналогично SEL4_USERNAME / SEL4_PASSWORD / SEL4_ACCOUNT_ID и т. д.)
# Необязательные подписи и регионы на каждый аккаунт: SEL3_LABEL, SEL3_SCANNER_REGIONS

# --- Регионы (опционально) ---
# Если не задано — сканер возьмёт ВСЕ регионы, доступные проекту.
# Для двух аккаунтов можно задать свои регионы на каждый воркер:
# SEL1_SCANNER_REGIONS=ru-1,ru-2,ru-3
# SEL2_SCANNER_REGIONS=ru-1,ru-2,ru-3

# ========== Скорость перебора IP и тайминги (опционально) ==========
# По умолчанию уже подобраны безопасные значения (~30 floating IP/мин).
# Трогайте, только если точно знаете, что делаете.
# SEL_MAX_IPS_PER_MINUTE=30
# SEL_TARGET_COUNT=1
# SEL_BATCH_SIZE=1
# SEL_MAX_BATCH_SIZE=1
# SEL_DELETE_CONCURRENCY=8
# Пауза при пустом ответе. HTTP 400/429 (quota/rate-limit) дают минимум 30/60 с автоматически.
# SEL_COOLDOWN_BASE=2.0
# SEL_COOLDOWN_MAX=60
# SEL_RECONCILE_INTERVAL=7
# SEL_ALLOCATION_POLL_ATTEMPTS=5
# SEL_ALLOCATION_POLL_DELAY=0.45
# SEL_REFRESH_PER_SECOND=6

# ========== Темп и устойчивость режима hunt (опционально) ==========
# Если Selectel начинает банить IP хоста за частые запросы (ConnectTimeout на
# эндпоинтах региона) — снизьте темп. Особенно если несколько аккаунтов охотятся
# с одного IP: суммарная нагрузка складывается.
# SEL_HUNT_DELAY=2                   # пауза между запросами внутри круга, с
# SEL_HUNT_ROUND_DELAY=5             # пауза между кругами, с
# Регион с подряд идущими ConnectTimeout ставится на короткую растущую паузу и
# автоматически возобновляется при первом успехе:
# SEL_HUNT_REGION_FAIL_THRESHOLD=3   # столько таймаутов подряд, прежде чем паузить регион
# SEL_HUNT_REGION_PAUSE_BASE=20      # стартовая пауза региона, с
# SEL_HUNT_REGION_PAUSE_MAX=180      # потолок паузы региона, с
# SEL_HUNT_CONNECT_TIMEOUT=8         # таймаут установки TCP-соединения, с (живой эндпоинт ~45 мс)
# Если Selectel забанил прямой IP хоста — пустить весь трафик к Selectel через прокси
# (нужен пакет socksio, он в httpx[socks]). Поддерживаются socks5:// и http(s)://:
# SEL_PROXY=socks5://user:pass@host:port

# ========== Telegram-уведомления для run.bat hunt (опционально) ==========
# 1) @BotFather → /newbot → токен сюда; 2) напишите боту /start;
# 3) run.bat tg-test покажет ваш chat_id и после его указания пришлёт тестовое сообщение.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_LABEL=       # подпись в сообщениях, если охот несколько (например: дом / vpn-1)
