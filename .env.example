# Toffee Roller — только то, без чего сервер не стартует.
# Ключи Selectel, прокси, подсети, паузы и Telegram настраиваются в панели и лежат в БД.

# Ключ шифрования секретов в БД (Fernet). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Потерять ключ = потерять доступ к сохранённым паролям и прокси. Храни отдельно от бэкапа БД.
APP_SECRET_KEY=

# По умолчанию SQLite в backend/data/roller.db
# DATABASE_URL=sqlite+aiosqlite:///./data/roller.db

# true за HTTPS на сервере: cookie только Secure, HSTS, без Swagger
PRODUCTION=false
LOG_LEVEL=INFO

# MailyGet: необязательные переопределения адресов для получения кода Selectel.
# {email} заменяется URL-кодированным email выбранного аккаунта, {id} — ID письма.
MAILYGET_LIST_URL=https://www.mailyget.com/api/emails/{email}?headers=true
MAILYGET_DETAIL_URL_TEMPLATE=https://www.mailyget.com/api/emails/{email}/{id}
# Только если API требует авторизацию; значения остаются на backend.
MAILYGET_AUTHORIZATION=
MAILYGET_COOKIE=
