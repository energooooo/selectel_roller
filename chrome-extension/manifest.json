{
  "manifest_version": 3,
  "name": "Toffee Roller для Selectel",
  "version": "2.1.2",
  "description": "Вход в аккаунты Selectel в один клик: автоподстановка, авто-код из почты и подключение аккаунта в панель Toffee Roller.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://my.selectel.ru/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "Toffee Roller",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "accounts.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://my.selectel.ru/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://my.selectel.ru/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://my.selectel.ru/*"],
      "js": ["overlay.js", "content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
